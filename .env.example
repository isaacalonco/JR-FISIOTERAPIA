# ==============================================================================
# JR SAÚDE 1.0 - ARQUIVO DE EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local: cp .env.example .env.local
# 2. Preencha os valores reais de acordo com o seu projeto Supabase.
# 3. NUNCA faça commit de arquivos .env.local ou credenciais secretas no Git!
# ==============================================================================

# AMBIENTE
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_NAME="JR SAÚDE"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SUPABASE - CLIENTE PÚBLICO (Acessível no Browser e Servidor)
# Obtido em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE - SERVICE ROLE KEY (CRÍTICO: USO EXCLUSIVO SERVER-SIDE / BACKEND)
# NUNCA utilize este token no frontend ou em variáveis com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SEGURANÇA E SESSÃO
# Chave aleatória de 32+ bytes para assinatura e criptografia de cookies/sessões
SESSION_SECRET="altere-para-uma-chave-secreta-com-pelo-menos-32-caracteres"

# INTEGRAÇÕES FUTURAS (PREPARADO PARA FASES 8+)
# WHATSAPP BUSINESS API (OFICIAL)
WHATSAPP_API_URL=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# OPENAI / INTELIGÊNCIA ARTIFICIAL
OPENAI_API_KEY=""
